@using System.Linq
@using Coactivos_Predial.Shared.Models
@using Coactivos_Predial.Shared.Services
@using Coactivos_Predial.Shared.Services.SPredios
@using Coactivos_Predial.Shared.Services.SPredios.Responses
@inject BusquedaService busquedaService
@inject IPrediosService prediosService

<div>
    <form class="flex flex-col gap-3 sm:flex-row sm:items-end" @onsubmit="BuscarPorCedula" @onsubmit:preventDefault>
        <div class="flex-1">
            <UiField Label="Documento" For="busqueda-documento">
                <UiInput Id="busqueda-documento"
                         @bind-Value="pcedula"
                         Mono="true"
                         Placeholder="Cédula o NIT"
                         Autocomplete="off"/>
            </UiField>
        </div>
        <UiButton ButtonType="submit" Variant="primary">
            <UiIcon Name="search"/>
            Buscar
        </UiButton>
    </form>

    <div class="mt-4">
        <UiTable Bordered="true">
            <Header>
                <tr>
                    <th>Código predial</th>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th class="text-right">Avalúo</th>
                </tr>
            </Header>
            <ChildContent>
                @if (prediosEncontrados.Any())
                {
                    @foreach (var item in GetPaginaActual())
                    {
                        <tr class="@($"cursor-pointer {(predioSeleccionado?.CodigoPredial == item.CodigoPredial ? "bg-accent-50" : string.Empty)}")"
                            @onclick="() => SeleccionarFila(item)">
                            <td class="font-numeric">@item.CodigoPredial</td>
                            <td>@item.Nombre</td>
                            <td>@item.Direccion</td>
                            <td class="num">@((item.Avaluo ?? 0).ToString("C"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-8 text-center text-ink-500">
                            No hay resultados. Ingrese un documento y presione Buscar.
                        </td>
                    </tr>
                }
            </ChildContent>
        </UiTable>
    </div>

    <UiPager Page="paginaActual" PageSize="5" TotalItems="prediosEncontrados.Count" OnPageChanged="CambiarPagina"/>
    <div class="mt-4 flex flex-wrap justify-end gap-2">
        <UiButton Variant="secondary" OnClick="Cerrar">Cancelar</UiButton>
        <UiButton Variant="primary" OnClick="EnviarDatos" Disabled="@(predioSeleccionado is null)">
            <UiIcon Name="check"/>
            Seleccionar
        </UiButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback<string> OnSeleccionado { get; set; }
    [Parameter] public EventCallback OnCerrar { get; set; }

    private List<PredioBusquedaDto> prediosEncontrados = new();
    private PredioBusquedaDto? predioSeleccionado;
    private string? pcedula;
    private int paginaActual = 1;

    protected override void OnInitialized()
    {
        pcedula = busquedaService.ObtenerUltimoCodigoSeleccionado();
    }

    private IEnumerable<PredioBusquedaDto> GetPaginaActual()
    {
        int skip = (paginaActual - 1) * 5;
        return prediosEncontrados.Skip(skip).Take(5);
    }

    private async Task BuscarPorCedula()
    {
        if (!string.IsNullOrWhiteSpace(pcedula))
        {
            var resultado = await prediosService.BuscarPrediosPorCedula(pcedula.Trim());
            prediosEncontrados = resultado.IsSuccess && resultado.Value is not null
                ? resultado.Value
                : new List<PredioBusquedaDto>();
            predioSeleccionado = null;
            paginaActual = 1;
        }
    }

    private async Task CambiarPagina(int nuevaPagina)
    {
        paginaActual = nuevaPagina;
    }

    private async Task EnviarDatos()
    {
        if (predioSeleccionado is null)
        {
            return;
        }

        var codigoPredial = predioSeleccionado.CodigoPredial;
        await busquedaService.GuardarCodigoSeleccionado(codigoPredial);
        if (OnSeleccionado.HasDelegate)
        {
            await OnSeleccionado.InvokeAsync(codigoPredial);
        }
    }

    private async Task Cerrar()
    {
        if (OnCerrar.HasDelegate)
        {
            await OnCerrar.InvokeAsync();
        }
    }

    private void SeleccionarFila(PredioBusquedaDto item)
    {
        predioSeleccionado = item;
    }

}
