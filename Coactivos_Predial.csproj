<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TailwindBinary Condition="'$(OS)' == 'Windows_NT'">$(MSBuildProjectDirectory)/tools/tailwindcss.exe</TailwindBinary>
    <TailwindBinary Condition="'$(OS)' != 'Windows_NT'">$(MSBuildProjectDirectory)/tools/tailwindcss</TailwindBinary>
  </PropertyGroup>

  <!-- Compila Tailwind antes del build si el binario local está disponible. -->
  <Target Name="BuildTailwind" BeforeTargets="Build;Publish" Condition="Exists('$(TailwindBinary)')">
    <Exec Command="&quot;$(TailwindBinary)&quot; -i &quot;$(MSBuildProjectDirectory)/Styles/app.css&quot; -o &quot;$(MSBuildProjectDirectory)/wwwroot/css/app.css&quot; --minify" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="iTextSharp" Version="5.5.13.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
    <PackageReference Include="Radzen.Blazor" Version="11.1.7" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\Rep_Coactivo\" />
    <Compile Remove="Coactivos_Predial.Tests/**/*.cs" />
    <Content Remove="Coactivos_Predial.Tests/**/*" />
    <Folder Include="Shared\Services\Document\Reponses\" />
    <None Remove="Coactivos_Predial.Tests/**/*" />
    <EmbeddedResource Remove="Coactivos_Predial.Tests/**/*" />
  </ItemGroup>

</Project>
