@page "/ReporteDiario"

@using Coactivos_Predial.Models;
@using Coactivos_Predial.Shared.Models;
@using Coactivos_Predial.Shared.Services;
@using System.Diagnostics
@inject NavigationManager NavigationManager
@inject IPrediosService Rep_resolServices;

<div class="container-fluid my-4">
    <!-- Header y Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4 class="card-title text-primary mb-3">
                <i class="bi bi-calendar-check me-2"></i>Reporte Diario de Documentos
            </h4>
            <div class="row g-3 align-items-end">
                <div class="col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small text-muted">Desde Fecha</label>
                    <input type="date" class="form-control" @bind="desde" />
                </div>
                <div class="col-sm-6 col-md-3 col-lg-2">
                    <label class="form-label fw-bold small text-muted">Hasta Fecha</label>
                    <input type="date" class="form-control" @bind="hasta" />
                </div>
                <div class="col-sm-12 col-md-2">
                    <button type="button" class="btn btn-primary w-100" @onclick="Carga_datos">
                        <i class="bi bi-search me-1"></i> Consultar
                    </button>
                </div>

                <!-- Tarjetas de Resumen KPI -->
                <div class="col-sm-6 col-md-2">
                    <div class="card border-0 bg-light shadow-sm">
                        <div class="card-body p-2 d-flex align-items-center">
                            <div class="fs-2 text-primary me-3 ps-2">
                                <i class="bi bi-card-checklist"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Items</div>
                                <div class="fw-bold fs-5">@itemx.item</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-sm-6 col-md-2">
                    <div class="card border-0 bg-light shadow-sm">
                        <div class="card-body p-2 d-flex align-items-center">
                            <div class="fs-2 text-danger me-3 ps-2">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </div>
                            <div>
                                <div class="text-muted small">PDFs</div>
                                <div class="fw-bold fs-5">@itemx.num</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de Resultados -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0 fs-6"><i class="bi bi-journal-text me-2"></i>Informe Documentos Cargados</h5>
            <span class="badge bg-light text-dark">Total: @Itemlist.Count</span>
        </div>
        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Cargando reporte...</p>
                </div>
            }
            else if (Itemlist == null || !Itemlist.Any())
            {
                <p class="text-muted text-center py-4 my-0">No se encontraron documentos registrados en el rango seleccionado.</p>
            }
            else
            {
                <div class="table-responsive" style="max-height: 550px; overflow-y: auto;">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>No. Predial</th>
                                <th>Fecha</th>
                                <th class="text-center">No. Documentos Cargados</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in Itemlist)
                            {
                                <tr>
                                    <td class="fw-bold">@doc.codigo_predial</td>
                                    <td>@doc.fecha.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info text-dark fs-6">@doc.num</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool mostrarModal = false;
    public List<Documentos> Itemlist { get; set; } = new List<Documentos>();
    public Item_res itemx { get; set; } = new Item_res();
    public DateTime desde;
    public DateTime hasta;

    IQueryable<Documentos> data;
    bool isLoading = false;
    public int num_ss;

    protected override async Task OnInitializedAsync()
    {
        desde = DateTime.Now;
        hasta = DateTime.Now;
    }

    async Task ShowLoading()
    {
        isLoading = true;
        await Task.Yield();
        isLoading = false;
    }

    private async Task Carga_datos()
    {
        try
        {
            await ShowLoading();
            Itemlist = await Rep_resolServices.Lista_Diario(desde, hasta);
            data = Itemlist.AsQueryable();
            itemx = await Rep_resolServices.Pdfs_Resumen(desde, hasta);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en getresoluciones: {ex.Message}");
        }
    }
}