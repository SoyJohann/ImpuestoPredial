@page "/ReporteDiario"

@using Coactivos_Predial.Shared.Services.SPredios
@using Coactivos_Predial.Shared.Services.SPredios.Responses

@rendermode InteractiveServer
@inject IPrediosService Rep_resolServices;

<PageTitle>Reporte diario</PageTitle>

<div>
    <h1 class="text-[22px] font-semibold leading-7 text-ink-900">Reporte diario de documentos</h1>
    <p class="mt-1 text-sm text-ink-500">Documentos cargados por predio en el rango de fechas seleccionado.</p>
</div>

<div class="mt-4">
    <UiPanel Title="Filtros" Subtitle="Seleccione el rango de fechas y consulte.">
        <form class="flex flex-col gap-3 sm:flex-row sm:items-end" @onsubmit="Carga_datos" @onsubmit:preventDefault>
            <UiField Label="Desde" For="reporte-desde">
                <input id="reporte-desde"
                       type="date"
                       @bind="desde"
                       class="@InputCss" />
            </UiField>
            <UiField Label="Hasta" For="reporte-hasta">
                <input id="reporte-hasta"
                       type="date"
                       @bind="hasta"
                       class="@InputCss" />
            </UiField>
            <UiButton ButtonType="submit" Variant="primary" Loading="isLoading">
                <UiIcon Name="search" />
                Consultar
            </UiButton>
        </form>
    </UiPanel>
</div>

@if (!string.IsNullOrWhiteSpace(errorCarga))
{
    <div class="mt-4 rounded-ui border border-danger-600/20 bg-danger-600/5 px-4 py-2.5 text-sm text-danger-600" role="alert">
        @errorCarga
    </div>
}

<div class="mt-4">
    <UiPanel Title="Documentos cargados" Subtitle="@Resumen" BodyClass="p-0">
        <Actions>
            <UiBadge Variant="neutral">Registros: @itemx.Item</UiBadge>
            <UiBadge Variant="accent">PDFs: @itemx.Num</UiBadge>
        </Actions>

        <ChildContent>
            @if (isLoading)
            {
                <div class="px-4">
                    <UiLoading Text="Consultando el reporte…" />
                </div>
            }
            else if (!consultado)
            {
                <UiEmpty Icon="calendar"
                         Title="Seleccione un rango de fechas"
                         Message="El reporte muestra los documentos cargados por predio dentro del rango consultado." />
            }
            else if (Itemlist.Count == 0)
            {
                <UiEmpty Icon="file-text"
                         Title="Sin documentos en el rango"
                         Message="No se encontraron documentos registrados entre las fechas seleccionadas." />
            }
            else
            {
                <UiTable Class="min-w-[560px]">
                    <Header>
                        <tr>
                            <th>No. predial</th>
                            <th>Fecha</th>
                            <th class="text-right">Documentos cargados</th>
                        </tr>
                    </Header>
                    <ChildContent>
                        @foreach (var documento in Itemlist)
                        {
                            <tr>
                                <td class="font-numeric">@documento.CodigoPredial</td>
                                <td class="font-numeric">@documento.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="num">@documento.Num</td>
                            </tr>
                        }
                    </ChildContent>
                </UiTable>
            }
        </ChildContent>
    </UiPanel>
</div>

@code {
    private const string InputCss = "h-8 w-full rounded-ui border border-line bg-surface px-3 text-sm text-ink-900 transition-colors duration-150 hover:border-ink-500/40 focus:border-accent-700 focus:outline-none focus:ring-2 focus:ring-accent-700/20";

    private List<DocumentoDiarioDto> Itemlist { get; set; } = new();
    private ResumenPdfsDto itemx { get; set; } = new(0, 0);
    private DateTime desde;
    private DateTime hasta;
    private bool isLoading;
    private bool consultado;
    private string? errorCarga;

    private string Resumen => !consultado
        ? "Sin consultar"
        : Itemlist.Count switch
        {
            0 => "Sin registros",
            1 => "1 registro",
            _ => $"{Itemlist.Count} registros"
        };

    protected override void OnInitialized()
    {
        desde = DateTime.Today;
        hasta = DateTime.Today;
    }

    private async Task Carga_datos()
    {
        errorCarga = null;

        if (desde.Date > hasta.Date)
        {
            errorCarga = "La fecha inicial no puede ser posterior a la fecha final.";
            return;
        }

        isLoading = true;
        try
        {
            var listaResult = await Rep_resolServices.Lista_Diario(desde.Date, hasta.Date);
            if (listaResult.IsFailure)
            {
                Itemlist.Clear();
                itemx = new ResumenPdfsDto(0, 0);
                consultado = true;
                errorCarga = listaResult.Error ?? "No fue posible consultar el reporte diario.";
                return;
            }

            var resumenResult = await Rep_resolServices.Pdfs_Resumen(desde.Date, hasta.Date);
            if (resumenResult.IsFailure)
            {
                errorCarga = resumenResult.Error ?? "No fue posible calcular el resumen de documentos.";
            }

            Itemlist = listaResult.Value ?? new List<DocumentoDiarioDto>();
            itemx = resumenResult.Value ?? new ResumenPdfsDto(0, 0);
            consultado = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
