@page "/Infractores"

@using Coactivos_Predial.Shared.Services.SPropietarios;
@using Coactivos_Predial.Shared.Services.SPropietarios.Responses;

@rendermode InteractiveServer
@inject IpropietariosService InfractoresService;

<PageTitle>Propietarios</PageTitle>

<div class="flex flex-wrap items-end justify-between gap-4">
    <div>
        <h1 class="text-[22px] font-semibold leading-7 text-ink-900">Propietarios</h1>
        <p class="mt-1 text-sm text-ink-500">Registro de propietarios e infractores asociados a los predios.</p>
    </div>
    <UiButton Variant="primary" OnClick="AbrirModalNuevo">
        <UiIcon Name="plus" />
        Agregar propietario
    </UiButton>
</div>

<div class="mt-4">
    <UiPanel Title="Propietarios" Subtitle="@Resumen" BodyClass="p-0">
        <div class="border-b border-line p-3">
            <form class="flex flex-col gap-2 sm:flex-row sm:items-end" @onsubmit="Buscar" @onsubmit:preventDefault>
                <div class="w-full sm:max-w-xs">
                    <UiField Label="Buscar por cédula" For="buscar-cedula">
                        <UiInput Id="buscar-cedula"
                                 @bind-Value="buscarnit"
                                 Mono="true"
                                 Placeholder="Digite la cédula"
                                 Autocomplete="off" />
                    </UiField>
                </div>
                <UiButton ButtonType="submit" Variant="secondary">
                    <UiIcon Name="search" />
                    Buscar
                </UiButton>
                @if (!string.IsNullOrWhiteSpace(buscarnit))
                {
                    <UiButton Variant="ghost" OnClick="LimpiarBusqueda">
                        <UiIcon Name="x" />
                        Limpiar
                    </UiButton>
                }
            </form>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorCarga))
        {
            <div class="border-b border-danger-600/20 bg-danger-600/5 px-4 py-2.5 text-sm text-danger-600" role="alert">
                @errorCarga
            </div>
        }

        @if (isLoading)
        {
            <div class="px-4">
                <UiLoading Text="Cargando propietarios…" />
            </div>
        }
        else if (infractores.Count == 0)
        {
            <UiEmpty Icon="users"
                     Title="No hay propietarios registrados"
                     Message="Agregue un propietario para asociarlo a los predios y procesos del municipio.">
                <Action>
                    <UiButton Variant="secondary" Size="sm" OnClick="AbrirModalNuevo">
                        <UiIcon Name="plus" />
                        Agregar propietario
                    </UiButton>
                </Action>
            </UiEmpty>
        }
        else
        {
            <UiTable Class="min-w-[760px]">
                <Header>
                    <tr>
                        <th>Documento</th>
                        <th>Nombre</th>
                        <th>Teléfono</th>
                        <th>Correo</th>
                        <th class="text-right">Acciones</th>
                    </tr>
                </Header>
                <ChildContent>
                    @foreach (var infractor in InfractoresPagina)
                    {
                        <tr>
                            <td class="font-numeric">@infractor.Documento</td>
                            <td>@(string.IsNullOrWhiteSpace(infractor.Nombre) ? "—" : infractor.Nombre)</td>
                            <td class="font-numeric">@(string.IsNullOrWhiteSpace(infractor.Telefono) ? "—" : infractor.Telefono)</td>
                            <td>@(string.IsNullOrWhiteSpace(infractor.Correo) ? "—" : infractor.Correo)</td>
                            <td class="actions">
                                <div class="flex justify-end">
                                    <UiButton Variant="ghost" Size="sm" OnClick="@(() => EditarInfractor(infractor))">
                                        <UiIcon Name="pencil" />
                                        Editar
                                    </UiButton>
                                </div>
                            </td>
                        </tr>
                    }
                </ChildContent>
            </UiTable>

            <div class="border-t border-line px-4 py-3">
                <UiPager Page="pagina"
                         PageSize="TamanoPagina"
                         TotalItems="infractores.Count"
                         OnPageChanged="CambiarPagina" />
            </div>
        }
    </UiPanel>
</div>

<UiDialog Open="mostrarModal"
          Title="@(esModoEditar ? "Editar propietario" : "Agregar propietario")"
          Subtitle="Los datos se usan para identificar al propietario en los procesos."
          Size="lg"
          OnClose="CerrarModal">
    <ChildContent>
        <form class="grid grid-cols-1 gap-4 sm:grid-cols-2" @onsubmit="Guardar" @onsubmit:preventDefault>
        <UiField Label="Tipo de identificación" For="tipo-identificacion" Required="true">
            <UiSelect Id="tipo-identificacion" @bind-Value="TipoIdSeleccionado">
                <option value="1">Cédula de ciudadanía</option>
                <option value="2">Tarjeta de identidad</option>
                <option value="3">Cédula de extranjería</option>
                <option value="4">NIT</option>
                <option value="6">Pasaporte</option>
                <option value="7">Carné diplomático</option>
                <option value="9">Cédula venezolana</option>
            </UiSelect>
        </UiField>

        <UiField Label="Documento" For="documento" Required="true" Help="Sin puntos ni espacios.">
            <UiInput Id="documento"
                     @bind-Value="infractoresobj.Documento"
                     Mono="true"
                     MaxLength="13"
                     Placeholder="Número de documento" />
        </UiField>

        <UiField Label="Nombre completo" For="nombre" Required="true" Class="sm:col-span-2">
            <UiInput Id="nombre"
                     @bind-Value="infractoresobj.Nombre"
                     MaxLength="30"
                     Placeholder="Nombre o razón social" />
        </UiField>

        <UiField Label="Correo" For="correo">
            <UiInput Id="correo"
                     @bind-Value="infractoresobj.Correo"
                     Type="email"
                     MaxLength="40"
                     Placeholder="correo@ejemplo.com" />
        </UiField>

        <UiField Label="Teléfono" For="telefono">
            <UiInput Id="telefono"
                     @bind-Value="infractoresobj.Telefono"
                     InputMode="tel"
                     MaxLength="15"
                     Placeholder="Número de contacto" />
        </UiField>

        @if (!string.IsNullOrWhiteSpace(errorModal))
        {
            <div class="rounded-ui border border-danger-600/20 bg-danger-600/5 px-3 py-2 text-sm text-danger-600 sm:col-span-2" role="alert">
                @errorModal
            </div>
        }

        <button type="submit" class="hidden" aria-hidden="true"></button>
        </form>
    </ChildContent>

    <Footer>
        <UiButton Variant="secondary" OnClick="CerrarModal" Disabled="guardando">Cancelar</UiButton>
        <UiButton Variant="primary" OnClick="Guardar" Loading="guardando">
            @(esModoEditar ? "Actualizar" : "Agregar")
        </UiButton>
    </Footer>
</UiDialog>

<UiToast Visible="toastVisible"
         Message="toastMessage"
         Variant="toastVariant"
         OnClose="CerrarToast" />

@code {
    private const int TamanoPagina = 20;

    private bool mostrarModal;
    private bool esModoEditar;
    private bool isLoading;
    private bool guardando;
    private string? buscarnit;
    private string? errorCarga;
    private string? errorModal;
    private int pagina = 1;
    private PropietarioDto infractoresobj = CrearPropietario();
    private List<PropietarioDto> infractores = new();

    private bool toastVisible;
    private string toastMessage = string.Empty;
    private string toastVariant = "ok";

    private string Resumen => infractores.Count switch
    {
        0 => "Sin registros",
        1 => "1 registro",
        _ => $"{infractores.Count} registros"
    };

    private IEnumerable<PropietarioDto> InfractoresPagina =>
        infractores.Skip((pagina - 1) * TamanoPagina).Take(TamanoPagina);

    private string TipoIdSeleccionado
    {
        get => infractoresobj.TipoId.ToString();
        set
        {
            if (int.TryParse(value, out var id))
            {
                infractoresobj.TipoId = id;
            }
        }
    }

    protected override Task OnInitializedAsync() => CargarTodos();

    private async Task CargarTodos()
    {
        isLoading = true;
        errorCarga = null;
        try
        {
            var respuesta = await InfractoresService.GetAll();
            if (respuesta.IsFailure)
            {
                infractores.Clear();
                errorCarga = respuesta.Error ?? "No fue posible cargar los propietarios.";
                return;
            }

            infractores = respuesta.Value ?? new List<PropietarioDto>();
            pagina = 1;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(buscarnit))
        {
            await CargarTodos();
            return;
        }

        isLoading = true;
        errorCarga = null;
        try
        {
            var respuesta = await InfractoresService.GetInfractoresByCedula(buscarnit.Trim());
            if (respuesta.IsFailure)
            {
                infractores.Clear();
                errorCarga = respuesta.Error ?? "No fue posible buscar el propietario.";
                return;
            }

            infractores = respuesta.Value ?? new List<PropietarioDto>();
            pagina = 1;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LimpiarBusqueda()
    {
        buscarnit = string.Empty;
        await CargarTodos();
    }

    private void AbrirModalNuevo()
    {
        infractoresobj = CrearPropietario();
        esModoEditar = false;
        errorModal = null;
        mostrarModal = true;
    }

    private void EditarInfractor(PropietarioDto infractor)
    {
        infractoresobj = new PropietarioDto
        {
            Id = infractor.Id,
            Documento = infractor.Documento,
            TipoId = infractor.TipoId,
            Nombre = infractor.Nombre,
            Telefono = infractor.Telefono,
            Correo = infractor.Correo,
            TipoNombre = infractor.TipoNombre
        };
        esModoEditar = true;
        errorModal = null;
        mostrarModal = true;
    }

    private async Task Guardar()
    {
        errorModal = null;

        if (infractoresobj.TipoId <= 0)
        {
            errorModal = "Seleccione el tipo de identificación.";
            return;
        }

        if (string.IsNullOrWhiteSpace(infractoresobj.Documento))
        {
            errorModal = "Ingrese el número de documento.";
            return;
        }

        if (string.IsNullOrWhiteSpace(infractoresobj.Nombre))
        {
            errorModal = "Ingrese el nombre completo.";
            return;
        }

        guardando = true;
        try
        {
            var resultado = esModoEditar
                ? await InfractoresService.EditInfractores(infractoresobj)
                : await InfractoresService.Add(infractoresobj);

            if (resultado.IsFailure)
            {
                errorModal = resultado.Error ?? "No fue posible guardar el propietario.";
                return;
            }

            mostrarModal = false;
            buscarnit = string.Empty;
            await CargarTodos();
            MostrarToast(esModoEditar ? "Propietario actualizado." : "Propietario agregado.");
        }
        finally
        {
            guardando = false;
        }
    }

    private void CerrarModal()
    {
        if (guardando)
        {
            return;
        }

        mostrarModal = false;
    }

    private void CambiarPagina(int nuevaPagina) => pagina = nuevaPagina;

    private void MostrarToast(string mensaje, string variante = "ok")
    {
        toastMessage = mensaje;
        toastVariant = variante;
        toastVisible = true;
    }

    private void CerrarToast() => toastVisible = false;

    private static PropietarioDto CrearPropietario() => new() { TipoId = 1 };
}
