@page "/Parametrospage"

@using Coactivos_Predial.Shared.Services.SParametros;
@using Coactivos_Predial.Shared.Services.SParametros.Responses;

@rendermode InteractiveServer
@inject IParametroService ParametroService;

<PageTitle>Parámetros del sistema</PageTitle>

<div>
    <h1 class="text-[22px] font-semibold leading-7 text-ink-900">Parámetros del sistema</h1>
    <p class="mt-1 text-sm text-ink-500">Configuración institucional, de liquidación y valores adicionales.</p>
</div>

<div class="mt-4">
    <UiPanel Title="Parámetros" Subtitle="Edite los datos del municipio y los estados del proceso." BodyClass="p-0">
        <div class="border-b border-line px-4 pt-2">
            <div class="flex gap-1">
                <button type="button" class="@TabClass(tab1)" @onclick="() => displayTabs(1)">Liquidación</button>
                <button type="button" class="@TabClass(tab3)" @onclick="() => displayTabs(3)">Valor adicional</button>
            </div>
        </div>

        @if (tab1)
        {
            <div class="p-4">
                <form class="space-y-4" @onsubmit="Editparm" @onsubmit:preventDefault>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <UiField Label="Secretaría" For="param-nombre" Required="true">
                            <UiInput Id="param-nombre" @bind-Value="param_obj.Nombre" MaxLength="80" />
                        </UiField>
                        <UiField Label="Ciudad" For="param-ciudad" Required="true">
                            <UiInput Id="param-ciudad" @bind-Value="param_obj.Ciudad" MaxLength="40" />
                        </UiField>
                        <UiField Label="Dirección" For="param-direccion" Required="true">
                            <UiInput Id="param-direccion" @bind-Value="param_obj.Direccion" MaxLength="60" />
                        </UiField>
                        <UiField Label="NIT" For="param-nit">
                            <UiInput Id="param-nit" @bind-Value="param_obj.Nit" MaxLength="15" Mono="true" />
                        </UiField>
                        <UiField Label="Correo" For="param-correo">
                            <UiInput Id="param-correo" @bind-Value="param_obj.Correo" Type="email" MaxLength="60" />
                        </UiField>
                        <UiField Label="Teléfono" For="param-telefono">
                            <UiInput Id="param-telefono" @bind-Value="param_obj.Telefono" MaxLength="15" InputMode="tel" />
                        </UiField>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="rounded-ui border border-danger-600/20 bg-danger-600/5 px-3 py-2 text-sm text-danger-600" role="alert">
                            @errorMessage
                        </div>
                    }

                    <div class="flex justify-end">
                        <UiButton ButtonType="submit" Variant="primary" Loading="guardando">
                            Guardar parámetros
                        </UiButton>
                    </div>
                </form>
            </div>
        }

        @if (tab3)
        {
            <div class="p-4 space-y-4">
                <div class="flex items-center gap-2">
                    <input id="cobra-adicional"
                           type="checkbox"
                           class="h-4 w-4 rounded-ui border-line text-accent-700 focus:ring-2 focus:ring-accent-700/20"
                           @bind="param_obj.CobraAdicional" />
                    <label for="cobra-adicional" class="text-sm text-ink-900">Cobra valor adicional</label>
                </div>

                <div class="space-y-2">
                    <h3 class="text-sm font-medium text-ink-900">Estados del proceso</h3>

                    @if (isLoading)
                    {
                        <UiLoading Text="Cargando estados…" />
                    }
                    else if (estados_list.Count == 0)
                    {
                        <UiEmpty Icon="sliders"
                                 Title="Sin estados configurados"
                                 Message="No hay estados registrados para el valor adicional." />
                    }
                    else
                    {
                        <UiTable Class="min-w-[520px]">
                            <Header>
                                <tr>
                                    <th class="w-20">Id</th>
                                    <th>Estado del proceso</th>
                                    <th class="w-28 text-right">Porcentaje</th>
                                    <th class="text-right">Acción</th>
                                </tr>
                            </Header>
                            <ChildContent>
                                @foreach (var estado in estados_list)
                                {
                                    <tr>
                                        <td class="font-numeric">@estado.id</td>
                                        <td>@(string.IsNullOrWhiteSpace(estado.nombre) ? "—" : estado.nombre)</td>
                                        <td class="num">@estado.porc</td>
                                        <td class="actions">
                                            <div class="flex justify-end">
                                                <UiButton Variant="ghost" Size="sm" OnClick="@(() => EditarEstado(estado))">
                                                    <UiIcon Name="pencil" />
                                                    Editar
                                                </UiButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </ChildContent>
                        </UiTable>
                    }
                </div>
            </div>
        }
    </UiPanel>
</div>

<UiDialog Open="mostrarModal1"
          Title="Configuración del valor adicional"
          Subtitle="Ajuste el porcentaje aplicado al estado seleccionado."
          Size="md"
          OnClose="CerrarModal1">
    <ChildContent>
        <form class="space-y-4" @onsubmit="ActualizarEstado" @onsubmit:preventDefault>
            <UiField Label="Id" For="estado-id">
                <UiInput Id="estado-id" Value="@agentesobj.id.ToString()" Disabled="true" Mono="true" />
            </UiField>
            <UiField Label="Detalle del proceso" For="estado-nombre" Required="true">
                <UiInput Id="estado-nombre" @bind-Value="agentesobj.nombre" MaxLength="80" />
            </UiField>
            <UiField Label="Porcentaje" For="estado-porc" Required="true">
                <UiInput Id="estado-porc" @bind-Value="PorcentajeTexto" InputMode="decimal" MaxLength="10" Mono="true" />
            </UiField>

            @if (!string.IsNullOrWhiteSpace(errorModal))
            {
                <div class="rounded-ui border border-danger-600/20 bg-danger-600/5 px-3 py-2 text-sm text-danger-600" role="alert">
                    @errorModal
                </div>
            }

            <button type="submit" class="hidden" aria-hidden="true"></button>
        </form>
    </ChildContent>
    <Footer>
        <UiButton Variant="secondary" OnClick="CerrarModal1" Disabled="guardandoEstado">Cancelar</UiButton>
        <UiButton Variant="primary" OnClick="ActualizarEstado" Loading="guardandoEstado">Actualizar</UiButton>
    </Footer>
</UiDialog>

<UiToast Visible="toastVisible"
         Message="toastMessage"
         Variant="toastVariant"
         OnClose="CerrarToast" />

@code {
    private bool tab1 = true;
    private bool tab3;
    private bool isLoading;
    private bool guardando;
    private bool guardandoEstado;
    private bool mostrarModal1;
    private string? errorMessage;
    private string? errorModal;
    private ParametroDto param_obj = new();
    private List<EstadoProcesoDto> estados_list = new();
    private EstadoProcesoDto agentesobj = new();
    private string PorcentajeTexto
    {
        get => agentesobj.porc.ToString(System.Globalization.CultureInfo.InvariantCulture);
        set
        {
            if (float.TryParse(value, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
            {
                agentesobj.porc = parsed;
            }
        }
    }

    private bool toastVisible;
    private string toastMessage = string.Empty;
    private string toastVariant = "ok";

    protected override async Task OnInitializedAsync()
    {
        await CargarParametros();
        await CargarEstados();
    }

    private async Task CargarParametros()
    {
        try
        {
            var respuesta = await ParametroService.GetParametroById(1);
            param_obj = respuesta.IsSuccess && respuesta.Value is not null
                ? respuesta.Value
                : new ParametroDto();
        }
        catch
        {
            param_obj = new ParametroDto();
        }
    }

    private async Task CargarEstados()
    {
        isLoading = true;
        try
        {
            var respuesta = await ParametroService.Getlist();
            estados_list = respuesta.Value ?? new List<EstadoProcesoDto>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Editparm()
    {
        errorMessage = null;
        if (!IsValid(param_obj))
        {
            errorMessage = "Los campos Secretaría y Dirección son obligatorios.";
            return;
        }

        guardando = true;
        try
        {
            var resultado = await ParametroService.EditParametros(1, param_obj);
            if (resultado.IsSuccess)
            {
                MostrarToast("Parámetros actualizados.");
            }
            else
            {
                errorMessage = resultado.Error ?? "No fue posible actualizar los parámetros.";
                MostrarToast(errorMessage, "danger");
            }
        }
        finally
        {
            guardando = false;
        }
    }

    private bool IsValid(ParametroDto param) =>
        !string.IsNullOrWhiteSpace(param.Nombre) && !string.IsNullOrWhiteSpace(param.Direccion);

    private void displayTabs(int tabNumber)
    {
        tab1 = tabNumber == 1;
        tab3 = tabNumber == 3;
    }

    private string TabClass(bool active) => active
        ? "border-b-2 border-accent-700 px-4 py-2 text-sm font-medium text-accent-700"
        : "border-b-2 border-transparent px-4 py-2 text-sm font-medium text-ink-500 transition-colors duration-150 hover:text-ink-900";

    private void EditarEstado(EstadoProcesoDto estado)
    {
        agentesobj = new EstadoProcesoDto
        {
            id = estado.id,
            nombre = estado.nombre,
            porc = estado.porc
        };
        errorModal = null;
        mostrarModal1 = true;
    }

    private async Task ActualizarEstado()
    {
        errorModal = null;

        if (string.IsNullOrWhiteSpace(agentesobj.nombre))
        {
            errorModal = "Ingrese el detalle del proceso.";
            return;
        }

        guardandoEstado = true;
        try
        {
            var resultado = await ParametroService.EditEstados(agentesobj);
            if (resultado.IsFailure)
            {
                errorModal = resultado.Error ?? "No fue posible actualizar el estado.";
                return;
            }

            mostrarModal1 = false;
            await CargarEstados();
            MostrarToast("Estado actualizado.");
        }
        finally
        {
            guardandoEstado = false;
        }
    }

    private void CerrarModal1()
    {
        if (guardandoEstado)
        {
            return;
        }

        mostrarModal1 = false;
    }

    private void MostrarToast(string mensaje, string variante = "ok")
    {
        toastMessage = mensaje;
        toastVariant = variante;
        toastVisible = true;
    }

    private void CerrarToast() => toastVisible = false;
}
