@page "/Rep_coactivopage"
@using Coactivos_Predial.Reportes
@using Coactivos_Predial.Shared.Components
@using Coactivos_Predial.Shared.Models
@using Coactivos_Predial.Shared.Services.SCoactivos;
@inject NavigationManager NavigationManager;
@inject BusquedaService busquedaService;
@inject IJSRuntime JSRuntime
@inject ICoactivosService coactivoServices;
@inject HttpClient _httpClient
@rendermode InteractiveServer

<div class="content-wrapper">
	<section class="content-header">
		<div class="card">
			<div class="card-header p-0" style="background-color:#112366; height: 27px;">
				<h5 class="card-title ms-2 mt-1" style="font-size:17px; color:white">Informes Coactivo</h5>
			</div>

			<div class="container-fluid">
				<div class="row pt-2 align-items-center">
					<div class="col-sm-3">
						<div class="d-flex gap-2">
							<button type="button" style="font-size:12px;" class="btn btn-primary" @onclick="Carga_per">Consultar</button>
							<button type="button" style="font-size:12px;" class="btn btn-danger" @onclick="GenerarPdf">Impresión Pdfs</button>
						</div>
					</div>
					<div class="col-sm-2">
						<div class="form-group">
							<label style="font-size:12px">Opción</label>
							<select @onchange="capturar" id="lClaseVehiculo" class="form-control col-auto" style="width:180px; font-size:12px;">
								<option value="0">Todos</option>
								<option value="1">No. Predio</option>
								<option value="2">No. Transacción</option>
							</select>
						</div>
					</div>
					@if (!Iscomp)
					{
						<div class="col-3">
							<label style="font-size:12px">No Predio</label>
							<div class="input-group">
								<input type="text" maxlength="20" disabled="@Iscomp" class="form-control col-auto" @bind="pcomp">
								<div class="input-group-append">
									<button type="button" @onclick="ShowBusqueda" disabled="@Iscomp" class="btn btn-primary" style="box-shadow:none; border-radius:0; height:28px;">
										<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-three-dots" viewBox="0 0 16 16" style="margin-top:5px;">
											<path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
										</svg>
									</button>
								</div>
							</div>
						</div>
					}
					@if (!Istran)
					{
						<div class="col-3">
							<div class="form-group">
								<label style="font-size:12px">Transaccion</label>
								<div class="input-group">
									<input type="text" disabled="@Istran" style="width:50px" class="form-control col-auto" @bind="tran">
									<div class="input-group-append">
										<button type="button" @onclick="Muestra_tran" disabled="@Istran" class="btn btn-primary" style="box-shadow:none; border-radius:0; height:28px;">
											<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-three-dots" viewBox="0 0 16 16" style="margin-top:5px;">
												<path d="M3 9.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3m5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3" />
											</svg>
										</button>
									</div>
								</div>
							</div>
						</div>
					}
				</div>

				<ul class="nav nav-tabs pt-3" id="custom-content-below-tab" role="tablist">
					<li class="nav-item">
						<button type="button" class="nav-link @(tab1 ? "active" : "")" id="pestañaPersuasivo" @onclick="() => displayTabs(1)">
							<h5 class="m-0">Proceso Persuasivo</h5>
						</button>
					</li>
					<li class="nav-item">
						<button type="button" class="nav-link @(tab2 ? "active" : "")" id="pestañaCoactivo" @onclick="() => displayTabs(2)">
							<h5 class="m-0">Proceso Coactivo</h5>
						</button>
					</li>
				</ul>

				@if (tab1)
				{
					<div class="tab-content" id="custom-content-below-tabContent">
						<div class="tab-pane fade show active" role="tabpanel">
							<div class="row p-2">
								<div class="col-12">
									<div class="card-body mt-1">
										@if (isLoading)
										{
											<div class="text-center my-4">
												<div class="spinner-border text-primary" role="status">
													<span class="visually-hidden">Cargando...</span>
												</div>
											</div>
										}
										else
										{
											<div class="table-responsive">
												<table class="table table-striped table-hover align-middle">
													<thead class="table-light">
														<tr>
															<th style="width: 190px;">Codigo Predio</th>
															<th style="width: 120px;">Fecha</th>
															<th style="width: 200px;">Cédula</th>
															<th style="width: 220px;">Nombre Infractor</th>
															<th style="width: 160px;">Resolución</th>
															<th class="text-end" style="width: 160px;">Valor</th>
															<th style="width: 1px;"></th>
														</tr>
													</thead>
													<tbody>
														@if (Itemper != null && Itemper.Any())
														{
															@foreach (var item in Itemper)
															{
																<tr>
																	<td>@item.codigo</td>
																	<td>@item.fecha.ToString("dd/MM/yyyy")</td>
																	<td>@item.cedula</td>
																	<td>@item.pnombres</td>
																	<td>@item.resolucion</td>
																	<td class="text-end">@item.valor.ToString("C")</td>
																	<td></td>
																</tr>
															}
														}
														else
														{
															<tr>
																<td colspan="7" class="text-center text-muted">No hay registros cargados.</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				}

				@if (tab2)
				{
					<div class="tab-content">
						<div class="tab-pane fade show active" role="tabpanel">
							<div class="row p-2">
								<div class="col-12">
									<div class="card-body mt-1">
										@if (isLoading)
										{
											<div class="text-center my-4">
												<div class="spinner-border text-primary" role="status">
													<span class="visually-hidden">Cargando...</span>
												</div>
											</div>
										}
										else
										{
											<div class="table-responsive">
												<table class="table table-striped table-hover align-middle">
													<thead class="table-light">
														<tr>
															<th style="width: 130px;">Codigo</th>
															<th style="width: 120px;">Fecha</th>
															<th style="width: 140px;">Cedula</th>
															<th style="width: 220px;">Nombre Infractor</th>
															<th style="width: 160px;">Resolucion</th>
															<th style="width: 160px;">Fecha Mandamiento</th>
															<th class="text-end" style="width: 160px;">Valor</th>
															<th style="width: 1px;"></th>
														</tr>
													</thead>
													<tbody>
														@if (Itemlist != null && Itemlist.Any())
														{
															@foreach (var item in Itemlist)
															{
																<tr>
																	<td>@item.codigo</td>
																	<td>@item.fecha.ToString("dd/MM/yyyy")</td>
																	<td>@item.cedula</td>
																	<td>@item.pnombres</td>
																	<td>@item.resolucion</td>
																	<td>@item.fecha_mdto.ToString("dd/MM/yyyy")</td>
																	<td class="text-end">@item.valor.ToString("C")</td>
																	<td></td>
																</tr>
															}
														}
														else
														{
															<tr>
																<td colspan="8" class="text-center text-muted">No hay registros cargados.</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				}
				<div class="card-footer">
				</div>
			</div>
		</div>
	</section>
</div>

<!-- MODAL TRANSACCIONES GENERADAS -->
<div class="modal fade show" tabindex="-1" style="display: @(mostrarModal ? "block" : "none"); background-color: rgba(0,0,0,0.5);">
	<div class="modal-dialog modal-lg" style="border-radius: 20px; box-shadow: 0px 8px 16px rgba(12, 12, 12, 0.8);">
		<div class="modal-content" style="border-radius:30px;">
			<div class="modal-header text-white" style="background-color: #112366; border-radius: 20px 20px 0 0; overflow: hidden; height:40px;">
				<h5 style="font-size:17px;" class="modal-title">Transacciones Generadas</h5>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CerrarModal"></button>
			</div>
			<div class="modal-body bg-light bg-gradient">
				@if (Tranlist != null)
				{
					<div class="table-responsive">
						<table class="table table-striped table-hover align-middle">
							<thead class="table-light">
								<tr>
									<th style="width: 190px;">Transacción</th>
									<th style="width: 120px;">Fecha</th>
									<th style="width: 160px;">Cantidad</th>
									<th style="width: 1px;"></th>
								</tr>
							</thead>
							<tbody>
								@if (Tranlist.Any())
								{
									@foreach (var tranItem in Tranlist)
									{
										var isSelected = selectedtranItem == tranItem;
										<tr class="@(isSelected ? "table-primary" : "")" style="cursor: pointer;" @onclick="() => SeleccionarTranItem(tranItem)">
											<td>@tranItem.transaccion</td>
											<td>@tranItem.fecha.ToString("dd/MM/yyyy")</td>
											<td>@tranItem.No</td>
											<td></td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="4" class="text-center text-muted">No hay transacciones registradas.</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				}
			</div>
			<div class="modal-footer border-0">
				<div class="row w-100">
					<div class="col-6 text-start">
						<button type="button" style="font-size:12px;" class="btn btn-secondary" @onclick="CerrarModal">Cerrar</button>
					</div>
					<div class="col-6 text-end">
						<button type="button" style="font-size:12px;" class="btn btn-primary bg-success text-white" @onclick="EnviarDatos">
							<span>Seleccionar</span>
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- MODAL BÚSQUEDA DE PLACAS POR CÉDULA -->
<div class="modal fade show" tabindex="-1" style="display: @(mostrarModalBusqueda ? "block" : "none"); background-color: rgba(0,0,0,0.5);">
	<div class="modal-dialog modal-lg" style="border-radius: 30px; box-shadow: 0px 8px 16px rgba(12, 12, 12, 0.8);">
		<div class="modal-content" style="border-radius:30px;">
			<div class="modal-header text-white" style="background-color: #112366; border-radius: 30px 30px 0 0; overflow: hidden; height:40px;">
				<h5 class="modal-title fs-6">Busqueda Placas Por Cédula</h5>
				<button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="CerrarModalBusqueda"></button>
			</div>
			<div class="modal-body bg-light bg-gradient">
				<Busqueda />
			</div>
			<div class="modal-footer border-0">
				<button type="button" style="font-size:12px;" class="btn btn-secondary" @onclick="CerrarModalBusqueda">Cerrar</button>
			</div>
		</div>
	</div>
</div>

<script>
	function downloadFileFromStream(fileName, contentStreamReference) {
		contentStreamReference.arrayBuffer().then(arrayBuffer => {
			const blob = new Blob([arrayBuffer]);
			const url = URL.createObjectURL(blob);
			const anchorElement = document.createElement('a');
			anchorElement.href = url;
			anchorElement.download = fileName ?? '';
			anchorElement.click();
			anchorElement.remove();
			URL.revokeObjectURL(url);
		});
	}

	window.downloadFileFromStream = downloadFileFromStream;
</script>

@code
{
	private bool mostrarModal = false;
	private bool mostrarModalBusqueda = false;
	public List<Coactivos> Itemlist { get; set; } = new List<Coactivos>();
	public List<Coactivos> Itemper { get; set; } = new List<Coactivos>();
	public List<Coactivos> comp_obj { get; set; } = new List<Coactivos>();
	public List<Transac_Report> Tranlist { get; set; } = new List<Transac_Report>();
	private Transac_Report? selectedtranItem;

	public DateTime desde;
	public DateTime hasta;
	public int vig;
	public int tran;
	private string pcomp = "";
	public string cedula = "";
	private bool tab1 = true;
	private bool tab2 = false;
	public bool bot = false;
	Recibo_pago recibo_Pago = new Recibo_pago();
	bool isLoading = false;

	protected bool Isvig { get; set; }
	protected bool Iscomp { get; set; }
	protected bool Isfec { get; set; }
	protected bool Istran { get; set; }
	protected int SelectedItem { get; set; }

	public void displayTabs(int TabNumber)
	{
		switch (TabNumber)
		{
			case 1:
				this.tab1 = true;
				this.tab2 = false;
				break;
			case 2:
				this.tab1 = false;
				this.tab2 = true;
				break;
		}
	}

	private async Task Muestra_tran()
	{
		await ShowLoading();
		Tranlist = await coactivoServices.GetListtran("3", 0);
		MostrarModal();
		StateHasChanged();
	}

	private void SeleccionarTranItem(Transac_Report item)
	{
		selectedtranItem = item;
	}

	private async Task EnviarDatos()
	{
		try
		{
			if (selectedtranItem != null)
			{
				tran = selectedtranItem.transaccion;
				mostrarModal = false;
				StateHasChanged();
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al asignar comparendo: {ex.Message}");
		}
	}

	private async Task capturar(ChangeEventArgs e)
	{
		SelectedItem = int.Parse((string)e.Value!);
		if (SelectedItem == 0)
		{
			Isfec = true; Isvig = true; Iscomp = true; Istran = true;
		}
		if (SelectedItem == 3)
		{
			Isfec = false; Isvig = true; Iscomp = true; Istran = true;
		}
		if (SelectedItem == 2)
		{
			Isfec = true; Isvig = false; Iscomp = true; Istran = true;
		}

		if (SelectedItem == 1)
		{
			Isfec = true; Isvig = true; Iscomp = false; Istran = true;
		}
		if (SelectedItem == 4)
		{
			Isfec = true; Isvig = true; Iscomp = true; Istran = false;
		}
	}

	protected override async Task OnInitializedAsync()
	{
		Isfec = true; Isvig = true; Iscomp = true; Istran = true;
		vig = 2025; desde = DateTime.Now; hasta = DateTime.Now;
	}

	private async Task GenerarPdf()
	{
		await recibo_Pago.MdtoPdf(Itemlist);
		await Muestra_Pdf("Mdtos.pdf");
	}

	public async Task Muestra_Pdf(string xfile)
	{
		try
		{
			await DescargarYAbrirArchivo($"{xfile.Trim()}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error: {ex.Message}");
		}
	}

	private async Task<byte[]?> DescargarArchivo(string fileUrl)
	{
		try
		{
			HttpResponseMessage response = await _httpClient.GetAsync(fileUrl);
			response.EnsureSuccessStatusCode();
			byte[] archivoBytes = await response.Content.ReadAsByteArrayAsync();
			return archivoBytes;
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al descargar el archivo: {ex.Message}");
			return null;
		}
	}

	private async Task DescargarYAbrirArchivo(string fileName)
	{
		try
		{
			string fileUrl = $"{NavigationManager.BaseUri}api/archivos/{fileName}";
			var fileBytes = await DescargarArchivo(fileUrl);
			if (fileBytes != null)
			{
				var contentStream = new DotNetStreamReference(new MemoryStream(fileBytes));
				await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, contentStream);
			}
			else
			{
				Console.WriteLine($"Error: No se pudo descargar el archivo {fileName}.");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al descargar y abrir el archivo: {ex.Message}");
		}
	}

	private void CerrarModal()
	{
		mostrarModal = false;
	}

	public void MostrarModal()
	{
		mostrarModal = true;
	}

	async Task ShowLoading()
	{
		isLoading = true;
		await Task.Yield();
		isLoading = false;
	}

	private async Task Carga_per()
	{
		try
		{
			await ShowLoading();
			if (tab1)
			{
				// Itemper = await coactivoServices.Lista_Coactivos(SelectedItem, pcomp, desde, hasta, vig, tran, 2);
			}
			if (tab2)
			{
				Itemlist = await coactivoServices.Lista_Coactivos(SelectedItem, pcomp, vig, 0, 2);
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error : {ex.Message}");
		}
	}

	private async Task obtenercompare()
	{
		try
		{
			string result = busquedaService.ObtenerUltimoComparendoCapturado();
			pcomp = result;
			Console.WriteLine($"result es: {result}");
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error al asignar comparendo: {ex.Message}");
		}
	}

	async Task ShowBusqueda()
	{
		mostrarModalBusqueda = true;
	}

	private void CerrarModalBusqueda()
	{
		mostrarModalBusqueda = false;
		obtenercompare();
	}
}