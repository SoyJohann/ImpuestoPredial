@page "/Consultapage"
@using Coactivos_Predial.Shared.Components;
@using Coactivos_Predial.Shared.Models;
@using Coactivos_Predial.Shared.Services.SDatabase
@using Coactivos_Predial.Shared.Services.SPropietarios;
@using Coactivos_Predial.Shared.Services.Document
@using Coactivos_Predial.Shared.Services.Document.Enums
@using Coactivos_Predial.Shared.Services.Document.Interfaces
@using Coactivos_Predial.Shared.Services.SPredios
@using Coactivos_Predial.Shared.Services.SDocumentos

@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDocumentoLinkService DocumentoLinkService
@inject ITiposDocumentoService tiposDocumentoService
@inject ITenantProvider Tenant
@inject IPrediosService prediosService
@inject Coactivos_Predial.Shared.Services.SDocumentos.SDocumentosService sDocumentosService
@inject IpropietariosService propietariosService

<PageTitle>Consulta de predio</PageTitle>

<div>
    <h1 class="text-[22px] font-semibold leading-7 text-ink-900">Consulta de predio</h1>
    <p class="mt-1 text-sm text-ink-500">Busque por código predial o cédula y gestione los documentos asociados.</p>
</div>

<div class="mt-4">
    <UiPanel>
        <form class="flex flex-col lg:flex-row items-center gap-4" @onsubmit="Consultar" @onsubmit:preventDefault>
            <div class="w-full flex-1">
                <UiField Label="Código predial" For="codigo-predial" Help="Ingrese el código y presione Consultar.">
                    <UiInput Id="codigo-predial"
                             @bind-Value="codigoPredial"
                             Mono="true"
                             Placeholder="Ej. 01-02-0034-0012-000"
                             Autocomplete="off"
                             Autofocus="true" />
                </UiField>
            </div>
            <div class="flex items-center gap-2">
                <UiButton ButtonType="button" Variant="primary" OnClick="Consultar">
                    <UiIcon Name="search" />
                    Consultar
                </UiButton>
                <UiButton Variant="secondary" OnClick="ShowBusqueda">
                    <UiIcon Name="folder-open" />
                    Buscar por cédula
                </UiButton>
            </div>
        </form>
    </UiPanel>
</div>

@if (!string.IsNullOrWhiteSpace(errorBusqueda))
{
    <div class="mt-4 rounded-ui border border-danger-600/20 bg-danger-600/5 px-4 py-2.5 text-sm text-danger-600" role="alert">
        @errorBusqueda
    </div>
}
else if (busquedaRealizada && !isLoading && Predio is null)
{
    <div class="mt-4 rounded-ui border border-warn-600/20 bg-warn-600/5 px-4 py-2.5 text-sm text-warn-600" role="alert">
        No se encontró un predio con ese código. Verifique el dato e intente de nuevo.
    </div>
}
else if (!busquedaRealizada)
{
    <div class="mt-4">
        <UiPanel BodyClass="p-0">
            <UiEmpty Icon="search"
                     Title="Consulte un predio"
                     Message="Ingrese el código predial o busque por cédula para ver la información y los documentos asociados." />
        </UiPanel>
    </div>
}

@if (busquedaRealizada && Predio is { } predio)
{
    <div class="mt-4 grid grid-cols-1 items-start gap-5 lg:grid-cols-[340px_minmax(0,1fr)]">
        
        <!-- COLUMNA IZQUIERDA (Sticky): Ficha Catastral, Propietarios y Coactivo -->
        <div class="space-y-4 lg:sticky lg:top-4">
            
            <!-- 1. Ficha del Predio -->
            <UiPanel Title="Ficha del Predio">
                <div class="mb-3 flex items-center justify-between rounded-ui border border-line bg-paper px-3 py-2">
                    <div>
                        <span class="block text-[11px] font-medium uppercase tracking-wider text-ink-500">Avalúo Catastral</span>
                        <span class="font-numeric text-base font-bold text-ink-900">@ptotalconrecFormated</span>
                    </div>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium @(predio.Exento == true ? "bg-warn-600/10 text-warn-600" : "bg-ok-600/10 text-ok-600")">
                        @(string.IsNullOrWhiteSpace(nentidad) ? "Sin dato" : nentidad)
                    </span>
                </div>

                <dl class="divide-y divide-line text-sm">
                    <div class="flex items-center justify-between gap-2 py-1.5">
                        <dt class="shrink-0 text-xs font-medium text-ink-500">Propietario</dt>
                        <dd class="truncate text-right font-medium text-ink-900" title="@predio.PropietarioNombre">
                            @(string.IsNullOrWhiteSpace(predio.PropietarioNombre) ? "Sin dato" : predio.PropietarioNombre)
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-2 py-1.5">
                        <dt class="shrink-0 text-xs font-medium text-ink-500">Cédula / NIT</dt>
                        <dd class="font-numeric truncate text-right text-ink-900">
                            @(string.IsNullOrWhiteSpace(predio.PropietarioDocumento) ? "—" : predio.PropietarioDocumento)
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-2 py-1.5">
                        <dt class="shrink-0 text-xs font-medium text-ink-500">Matrícula</dt>
                        <dd class="font-numeric truncate text-right text-ink-900">
                            @(string.IsNullOrWhiteSpace(predio.Matricula) ? "—" : predio.Matricula)
                        </dd>
                    </div>
                    <div class="flex items-center justify-between gap-2 py-1.5">
                        <dt class="shrink-0 text-xs font-medium text-ink-500">Dirección</dt>
                        <dd class="truncate text-right text-ink-900" title="@predio.Direccion">
                            @(string.IsNullOrWhiteSpace(predio.Direccion) ? "—" : predio.Direccion)
                        </dd>
                    </div>
                    <div class="grid grid-cols-2 gap-2 pt-2">
                        <div class="rounded-ui bg-paper px-2.5 py-1.5">
                            <span class="block text-[11px] text-ink-500">Área terreno</span>
                            <span class="font-numeric text-xs font-semibold text-ink-900">@(predio.AreaTerreno?.ToString("N0") ?? "—") m²</span>
                        </div>
                        <div class="rounded-ui bg-paper px-2.5 py-1.5">
                            <span class="block text-[11px] text-ink-500">Área construida</span>
                            <span class="font-numeric text-xs font-semibold text-ink-900">@(predio.AreaConstruida?.ToString("N0") ?? "—") m²</span>
                        </div>
                    </div>
                    <div class="flex items-center justify-between gap-2 pt-2">
                        <dt class="shrink-0 text-xs font-medium text-ink-500">Zona / Estrato</dt>
                        <dd class="truncate text-right text-xs text-ink-900">
                            @(string.IsNullOrWhiteSpace(predio.Zona) ? "—" : predio.Zona)
                            @if (!string.IsNullOrWhiteSpace(predio.Estrato))
                            {
                                <span class="text-ink-500"> / Estrato @predio.Estrato</span>
                            }
                        </dd>
                    </div>
                </dl>
            </UiPanel>

            <!-- 2. Propietarios (Compacto) -->
            <UiPanel Title="Propietarios" Subtitle="@PropietariosResumen" BodyClass="p-0">
                @if (isLoading)
                {
                    <div class="p-4"><UiLoading Text="Cargando propietarios…" /></div>
                }
                else if (PropietarioDto is null || !PropietarioDto.Any())
                {
                    <div class="px-4 py-5 text-center text-xs text-ink-500">
                        Sin propietarios adicionales registrados.
                    </div>
                }
                else
                {
                    <div class="max-h-48 divide-y divide-line overflow-y-auto">
                        @foreach (var prop in PropietarioDto)
                        {
                            <div class="flex items-center justify-between gap-2 px-4 py-2 text-xs">
                                <div class="min-w-0">
                                    <p class="truncate font-medium text-ink-900">@(string.IsNullOrWhiteSpace(prop.Nombre) ? "—" : prop.Nombre)</p>
                                    <p class="font-numeric text-ink-500">@prop.TipoId: @prop.Documento</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </UiPanel>

            <!-- 3. Coactivo y Procesos (Compacto) -->
            <UiPanel Title="Coactivo y procesos" Subtitle="@(string.IsNullOrWhiteSpace(nestado_proc) ? "Sin proceso" : nestado_proc)" BodyClass="p-0">
                @if (isLoading)
                {
                    <div class="p-4"><UiLoading Text="Cargando procesos…" /></div>
                }
                else if (ProcesosDto is null || !ProcesosDto.Any())
                {
                    <div class="px-4 py-5 text-center text-xs text-ink-500">
                        Este predio no registra procesos de cobro coactivo.
                    </div>
                }
                else
                {
                    <div class="max-h-48 divide-y divide-line overflow-y-auto">
                        @foreach (var proc in ProcesosDto)
                        {
                            <div class="flex items-center justify-between gap-2 px-4 py-2.5 text-xs">
                                <div>
                                    <p class="font-numeric font-medium text-ink-900">Res. @(string.IsNullOrWhiteSpace(proc.Resolucion) ? "—" : proc.Resolucion)</p>
                                    <p class="font-numeric text-ink-500">@FechaTexto(proc.FechaMandamiento)</p>
                                </div>
                                <UiBadge Variant="neutral">@proc.NombreEstado</UiBadge>
                            </div>
                        }
                    </div>
                }
            </UiPanel>
        </div>

        <!-- COLUMNA DERECHA: Explorador de Archivos en Grid -->
        <div class="min-w-0">
            <UiDocumentExplorer Documentos="DocumentosDto"
                                Tipos="TiposDocumento"
                                CarpetaSeleccionadaId="carpetaSeleccionada"
                                OnOpenCarpeta="AbrirCarpeta"
                                OnCerrarCarpeta="CerrarCarpeta"
                                OnVer="AbrirPdf"
                                OnDescargar="DescargarPdf"
                                OnCambiarTipo="async doc => await CambiarTipoIndividual(doc)"
                                OnCambiarTipoLote="CambiarTipoLote"
                                OnEliminar="PermisoEliminar"
                                OnSubir="tipoId => AbrirModalSubir(tipoId)"
                                OnDescargarCarpeta="DescargarCarpeta"
                                OnActualizar="ActualizarDocumentos" />
        </div>
    </div>
}

<!-- Visor de PDF (fuera del bloque del predio para que siempre exista) -->
<PdfViewerModal @ref="pdfViewerModal" />

<!-- Modal para cambiar tipo de documento -->
<UiDialog Open="@mostrarModalCambiarTipo"
          OnClose="CancelarCambiarTipo"
          Title="Cambiar tipo documental"
          Subtitle="@(documentoParaCambiar is null ? "" : documentoParaCambiar.Nombre)"
          Size="sm">
    <ChildContent>
        <div class="space-y-3">
            <UiField Label="Nuevo tipo de documento" For="cambiar-tipo">
                <UiSelect Id="cambiar-tipo" @bind-Value="tipoSeleccionadoParaCambiar">
                    @foreach (var tipo in TiposDocumento)
                    {
                        <option value="@tipo.Id">@tipo.Nombre</option>
                    }
                </UiSelect>
            </UiField>
            <p class="text-xs text-ink-500">
                El documento se moverá a la carpeta seleccionada. El archivo físico no se modificará.
            </p>
        </div>
    </ChildContent>
    <Footer>
        <UiButton Variant="secondary" OnClick="CancelarCambiarTipo">Cancelar</UiButton>
        <UiButton Variant="primary" OnClick="ConfirmarCambiarTipo">
            <UiIcon Name="swap-horizontal" />
            Cambiar tipo
        </UiButton>
    </Footer>
</UiDialog>

<!-- Búsqueda por cédula -->
<UiDialog Open="@mostrarModalBusqueda"
          OnClose="CerrarModalBusqueda"
          Title="Buscar predio por cédula"
          Subtitle="Seleccione el predio que desea consultar."
          Size="lg">
    <Busqueda OnSeleccionado="SeleccionarDesdeModal" OnCerrar="CerrarModalBusqueda" />
</UiDialog>

<!-- Confirmación de eliminación -->
<UiDialog Open="@mostrarConfirmacionEliminar"
          OnClose="CancelarEliminar"
          Title="Eliminar documento"
          Subtitle="Esta acción no se puede deshacer.">
    <ChildContent>
        <p class="text-sm text-ink-700">
            Se eliminará el documento
            <span class="font-medium text-ink-900">@docPendienteEliminar?.Nombre</span>.
        </p>
        <p class="font-numeric mt-2 break-all rounded-ui border border-line bg-paper px-3 py-2 text-xs text-ink-500">
            @(docPendienteEliminar?.NombreArchivo ?? docPendienteEliminar?.Ruta)
        </p>
    </ChildContent>
    <Footer>
        <UiButton Variant="secondary" OnClick="CancelarEliminar">Cancelar</UiButton>
        <UiButton Variant="danger-solid" OnClick="ConfirmarEliminar">
            <UiIcon Name="trash" />
            Eliminar documento
        </UiButton>
    </Footer>
</UiDialog>

<!-- Carga de documento -->
<UiDialog Open="@mostrarModalSubir"
          OnClose="CerrarModalSubir"
          Title="Subir PDF"
          Subtitle="Un archivo PDF de hasta 4 MB.">
    <ChildContent>
        <div class="space-y-3">
            <UiField Label="Tipo de documento" For="documento-tipo">
                <UiSelect Id="documento-tipo" @bind-Value="tipoDocumentoSeleccionado">
                    @foreach (var tipo in TiposDocumento)
                    {
                        <option value="@tipo.Id">@tipo.Nombre</option>
                    }
                </UiSelect>
            </UiField>

            <UiField Label="Detalle del documento" For="documento-nombre">
                <UiInput Id="documento-nombre"
                         @bind-Value="Documentos.Nombre"
                         Placeholder="Ej. Recibo de pago, notificación"
                         Autocomplete="off" />
            </UiField>

            <UiField Label="Archivo PDF" For="documento-archivo">
                <UiFileDrop @key="Documentos"
                            Id="documento-archivo"
                            FileName="@archivoSeleccionado"
                            Accept=".pdf"
                            Help="Solo archivos PDF, máximo 4 MB."
                            OnChange="ArchivoSeleccionado"
                            Error="@errors.FirstOrDefault()" />
            </UiField>
        </div>
    </ChildContent>
    <Footer>
        <UiButton Variant="secondary" OnClick="CerrarModalSubir">Cancelar</UiButton>
        <UiButton Variant="primary"
                  OnClick="SubirDocumento"
                  Loading="@subiendo"
                  Disabled="@(subiendo || string.IsNullOrWhiteSpace(Documentos.Nombre) || string.IsNullOrWhiteSpace(archivoSeleccionado) || loadedFiles.Count != 1)">
            <UiIcon Name="upload" />
            Subir PDF
        </UiButton>
    </Footer>
</UiDialog>

<UiToast Visible="@(!string.IsNullOrWhiteSpace(aviso))"
         Message="@(aviso ?? string.Empty)"
         Variant="ok"
         OnClose="CerrarAviso" />